# Banco: SQLite por padrão. Produção: postgresql+psycopg://usuario:senha@host:5432/lofi
# LOFI_DATABASE_URL=sqlite:///data/studio.db

# Instâncias ComfyUI declaradas (JSON). Hosts fora de localhost só entram por aqui.
# LOFI_COMFYUI_INSTANCES=["local=http://127.0.0.1:8188", "gpu2=http://192.168.0.20:8188"]
# LOFI_COMFYUI_SCAN_PORTS=[8188, 8189, 8190]
# LOFI_COMFYUI_TIMEOUT_S=600
# LOFI_COMFYUI_MAX_RETRIES=2

# LOFI_QUEUE_WORKERS=2
# LOFI_FFMPEG=ffmpeg
